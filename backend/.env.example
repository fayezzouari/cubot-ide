# Cubot IDE Backend Environment Variables

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cubot_ide

# AWS Bedrock (uses default AWS credentials if not set)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
BEDROCK_MODEL_ID=gpt-oss-120-v1:0

# Docker
DOCKER_SOCKET=unix:///var/run/docker.sock

# Compilation
COMPILE_TIMEOUT=60
