# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cubot_ide

# AWS Bedrock Configuration (for AI features)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Application Settings
PROJECT_NAME=Cubot IDE
PROJECT_VERSION=1.0.0

# Docker Simulator
SIMULATOR_IMAGE=cubot/avr-simulator:latest

# ROS sandboxes (Kubernetes) — uses $KUBECONFIG or ~/.kube/config.
# Apply k8s/sandboxes.yaml to the cluster first.
SANDBOX_NAMESPACE=cubot-sandboxes
SANDBOX_IMAGE=ros:humble-ros-base

# Security — must match NEXTAUTH_SECRET in frontend/.env.local
NEXTAUTH_SECRET=your-nextauth-secret-here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
