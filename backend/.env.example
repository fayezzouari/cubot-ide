# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cubot_ide

# AWS Bedrock Configuration (for AI features)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Application Settings
PROJECT_NAME=Cubot IDE
PROJECT_VERSION=1.0.0

# Docker Simulator
SIMULATOR_IMAGE=cubot/avr-simulator:latest

# Daytona Configuration (optional - for Daytona Cloud)
DAYTONA_API_KEY=  # Leave empty for local sandboxes

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
